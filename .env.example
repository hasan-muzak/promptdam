# Promptdam local development. `task promptdam:setup` copies this file to .env.
# Values match Promptdam's own stack (stack.env, `task promptdam:dev:stack`):
# its own Postgres, Valkey, ClickHouse and S3, exactly as it has its own VPS in
# production.
KEEL_ENV=development
KEEL_SERVICE=promptdam-api
KEEL_ADDR=:8281
KEEL_REGION=eu
KEEL_PUBLIC_URL=http://localhost:8281

# The gateway data plane listens separately; clients' base URL is
# PROMPTDAM_GATEWAY_URL + /v1.
PROMPTDAM_GATEWAY_ADDR=:8282
PROMPTDAM_GATEWAY_URL=http://localhost:8282

KEEL_APP_URL=http://localhost:3002
KEEL_CORS_ORIGINS=http://localhost:3002

KEEL_DATABASE_URL=postgres://keel:keel@localhost:25432/promptdam?sslmode=disable
KEEL_VALKEY_URL=redis://localhost:26379/0
KEEL_CLICKHOUSE_URL=clickhouse://keel:keel@localhost:29000/promptdam
# Postgres statements and ClickHouse queries running longer are ended (0: no
# limit; the migrate command never has one).
# KEEL_QUERY_TIMEOUT_SECONDS=30

# RustFS locally, Cloudflare R2 (EU jurisdiction) in production.
KEEL_S3_ENDPOINT=http://localhost:29100
KEEL_S3_REGION=us-east-1
KEEL_S3_ACCESS_KEY=keel
KEEL_S3_SECRET_KEY=keelkeel
KEEL_S3_BUCKET=promptdam

# Development only; production uses a random 32+ byte secret from the SOPS env.
KEEL_APIKEY_PEPPER=promptdam-development-pepper-not-secret-00

# Mailpit catches every email locally (UI at http://localhost:28025).
KEEL_MAIL_URL=smtp://localhost:21025
KEEL_MAIL_FROM=Promptdam <no-reply@promptdam.test>

# Users sign in with Idenzy (keel ADR 0009). With Idenzy running (`task
# dev:idenzy` in keel), `task promptdam:dev:idenzy` creates Promptdam's local
# project and writes the project and its secret key here.
KEEL_IDENZY_URL=http://localhost:3001
# KEEL_IDENZY_PROJECT=prj_…
# KEEL_IDENZY_SECRET_KEY=sk_…

# Master keys sealing customer secrets (provider API keys, webhook signing
# secrets, channel URLs): "1:<base64 32 bytes>" (openssl rand -base64 32).
# Unset in development: a fixed development key is used. Required elsewhere.
# KEEL_VAULT_KEYS=

# Model prices for costs and savings (pkg/llm's JSON shape). Unset: the
# embedded catalog.
# PROMPTDAM_MODEL_PRICES=/etc/promptdam/model-prices.json

# Promptdam Stripe sub-account, test mode. Without these, billing answers 503.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Or stripe-mock from the local stack:
# STRIPE_API_URL=http://localhost:22111
