# Promptdam's own local stack (infra/compose/product.yaml, compose project
# "promptdam"). Its ports are the 2xxxx block, so it runs beside every other
# product's stack. .env.example and the test task point at these ports.
KEEL_STACK_PRODUCT=promptdam
KEEL_STACK_POSTGRES_PORT=25432
KEEL_STACK_VALKEY_PORT=26379
KEEL_STACK_CLICKHOUSE_HTTP_PORT=28123
KEEL_STACK_CLICKHOUSE_PORT=29000
KEEL_STACK_S3_PORT=29100
KEEL_STACK_S3_CONSOLE_PORT=29101
KEEL_STACK_SMTP_PORT=21025
KEEL_STACK_MAILPIT_PORT=28025
KEEL_STACK_STRIPE_MOCK_PORT=22111
